{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:my-skills:schemas:learning-card",
  "title": "Learning Card response schema",
  "allOf": [
    {
      "$ref": "urn:eric:schemas:deliverable-content"
    },
    {
      "type": "object",
      "properties": {
        "deliverable_type": {
          "const": "learning_card"
        },
        "blocks": {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "section_key",
                    "text"
                  ],
                  "properties": {
                    "section_key": {
                      "const": "hypothesis"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "section_key",
                    "text"
                  ],
                  "properties": {
                    "section_key": {
                      "const": "observations"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "citation_ids": {
                  "minItems": 1
                }
              },
              "required": [
                "citation_ids"
              ]
            },
            {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "section_key",
                    "text"
                  ],
                  "properties": {
                    "section_key": {
                      "const": "learning"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "section_key",
                    "text"
                  ],
                  "properties": {
                    "section_key": {
                      "const": "action"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
