{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:my-skills:schemas:four-d-workshop-record",
  "title": "Four D Workshop Record response schema",
  "description": "Contrato mínimo das seções obrigatórias para uma versão completa. Versões parciais usam o envelope comum e declaram as lacunas.",
  "allOf": [
    {
      "$ref": "urn:eric:schemas:deliverable-content"
    },
    {
      "type": "object",
      "properties": {
        "deliverable_type": {
          "const": "four_d_workshop_record"
        },
        "citations": {
          "minItems": 1
        },
        "blocks": {
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "d1"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "d2"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "d3"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "d4"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            }
          ]
        }
      }
    }
  ]
}
