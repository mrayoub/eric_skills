{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:my-skills:schemas:innovation-potential-assessment",
  "title": "Innovation Potential Assessment response schema",
  "description": "Contrato mínimo das seções obrigatórias para uma versão completa. Versões parciais usam o envelope comum e declaram as lacunas.",
  "allOf": [
    {
      "$ref": "urn:eric:schemas:deliverable-content"
    },
    {
      "type": "object",
      "properties": {
        "deliverable_type": {
          "const": "innovation_potential_assessment"
        },
        "citations": {
          "minItems": 1
        },
        "blocks": {
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "impact"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "feasibility"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "alignment"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "urgency"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "novelty"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "recommendation"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "type",
                  "data"
                ],
                "properties": {
                  "type": {
                    "const": "table"
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "columns",
                      "rows",
                      "overall_score",
                      "classification"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "scores"
                      },
                      "columns": {
                        "type": "array"
                      },
                      "rows": {
                        "type": "array",
                        "minItems": 5,
                        "maxItems": 5,
                        "items": {
                          "type": "object",
                          "required": [
                            "criterion",
                            "score",
                            "weight",
                            "justification"
                          ],
                          "properties": {
                            "criterion": {
                              "enum": [
                                "impact",
                                "viability",
                                "strategic_alignment",
                                "urgency",
                                "innovation"
                              ]
                            },
                            "score": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "weight": {
                              "type": "number"
                            },
                            "justification": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      },
                      "overall_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "classification": {
                        "enum": [
                          "priorizar",
                          "monitorar",
                          "arquivar"
                        ]
                      }
                    }
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    }
  ]
}
