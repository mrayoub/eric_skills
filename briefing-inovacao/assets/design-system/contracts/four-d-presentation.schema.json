{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:my-skills:schemas:four-d-presentation",
  "title": "Four D Presentation response schema",
  "allOf": [
    {
      "$ref": "urn:eric:schemas:deliverable-content"
    },
    {
      "type": "object",
      "properties": {
        "deliverable_type": {
          "const": "four_d_presentation"
        },
        "citations": {
          "minItems": 1
        },
        "blocks": {
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "citation_ids",
                  "type",
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "challenge"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "citation_ids": {
                    "type": "array",
                    "minItems": 1
                  },
                  "type": {
                    "enum": [
                      "paragraph",
                      "heading",
                      "callout",
                      "metric"
                    ]
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "citation_ids",
                  "type",
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "findings"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "citation_ids": {
                    "type": "array",
                    "minItems": 1
                  },
                  "type": {
                    "enum": [
                      "paragraph",
                      "heading",
                      "callout",
                      "metric"
                    ]
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "citation_ids",
                  "type",
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "solution_hypothesis"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "citation_ids": {
                    "type": "array",
                    "minItems": 1
                  },
                  "type": {
                    "enum": [
                      "paragraph",
                      "heading",
                      "callout",
                      "metric"
                    ]
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "citation_ids",
                  "type",
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "convergence"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "citation_ids": {
                    "type": "array",
                    "minItems": 1
                  },
                  "type": {
                    "enum": [
                      "paragraph",
                      "heading",
                      "callout",
                      "metric"
                    ]
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "citation_ids",
                  "type",
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "section_key",
                      "text"
                    ],
                    "properties": {
                      "section_key": {
                        "const": "next_steps"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "citation_ids": {
                    "type": "array",
                    "minItems": 1
                  },
                  "type": {
                    "enum": [
                      "paragraph",
                      "heading",
                      "callout",
                      "metric"
                    ]
                  }
                }
              },
              "minContains": 1
            }
          ]
        }
      }
    }
  ],
  "description": "Seções obrigatórias da Apresentação 4D: devolutiva curta, de no máximo 6 slides de conteúdo, derivada da mesma análise do relatório."
}
