{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eric:schemas:deliverable-content",
  "title": "ERIC Canonical Deliverable Content",
  "description": "Envelope comum da representacao canonica e editavel de um entregavel ERIC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliverable_type",
    "locale",
    "title",
    "blocks",
    "citations",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "deliverable_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "locale": {
      "const": "pt-BR"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "rich_text",
            "list",
            "table",
            "metric",
            "image_ref",
            "chart",
            "canvas",
            "callout",
            "card_grid",
            "page_break"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "csv": {
              "type": "boolean",
              "default": false
            },
            "variant_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "export"
            ],
            "properties": {
              "export": {
                "required": [
                  "csv"
                ],
                "properties": {
                  "csv": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "table"
              },
              "export": {
                "required": [
                  "variant_key"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "card_grid"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "required": [
                  "cards"
                ],
                "properties": {
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "title": {
                    "type": "string"
                  },
                  "cards": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "required": [
                        "title"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string"
                        },
                        "value": {},
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "tone": {
                          "enum": [
                            "blue",
                            "neutral",
                            "red",
                            "green",
                            "yellow"
                          ]
                        },
                        "citation_ids": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    }
  }
}
