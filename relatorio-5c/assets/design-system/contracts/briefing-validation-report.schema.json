{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eric:schemas:briefing-validation-report",
  "title": "ERIC Briefing Validation Report",
  "description": "Contrato especializado do relatorio de validacao e IQB do briefing.",
  "allOf": [
    {
      "$ref": "urn:eric:schemas:deliverable-content"
    },
    {
      "type": "object",
      "properties": {
        "deliverable_type": {
          "const": "briefing_validation"
        },
        "metadata": {
          "type": "object",
          "required": [
            "briefing_version_id",
            "rubric_version"
          ],
          "properties": {
            "phase_key": {
              "type": "string",
              "minLength": 1,
              "description": "Contexto opcional da fase registrada; não controla o uso da skill."
            },
            "briefing_version_id": {
              "type": "string",
              "minLength": 1
            },
            "rubric_version": {
              "enum": [
                "1.0.0",
                "1.1.0-portable"
              ]
            }
          }
        },
        "blocks": {
          "allOf": [
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/challengeBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/hmwBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/scoresBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/iqbBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/strengthsBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/gapsBlock"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/provocationsBlock"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "challengeBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "title",
            "sponsor",
            "owner"
          ],
          "properties": {
            "section_key": {
              "const": "challenge"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "sponsor": {
              "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/person"
            },
            "owner": {
              "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/person"
            }
          }
        }
      }
    },
    "hmwBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "status",
            "original",
            "analysis",
            "suggestion"
          ],
          "properties": {
            "section_key": {
              "const": "hmw"
            },
            "status": {
              "enum": [
                "ok",
                "attention",
                "critical"
              ]
            },
            "original": {
              "type": "string",
              "minLength": 1
            },
            "analysis": {
              "type": "string",
              "minLength": 1
            },
            "suggestion": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "description": "Cargo opcional para governanca e exibicao; sua ausencia nao afeta o IQB."
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "answer",
        "evidence",
        "evidence_source"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^(CLA|EVI|OUT|ACT)-(0[1-9]|10)$"
        },
        "answer": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "enum": [
            "briefing",
            "transcription",
            "briefing_model",
            "absent"
          ]
        },
        "citation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimensionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "veto_item_id",
        "veto_max_score",
        "veto_triggered",
        "veto_detail",
        "yes_count",
        "raw_score",
        "final_score",
        "label",
        "justification"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/checklistItem"
          }
        },
        "veto_item_id": {
          "type": "string"
        },
        "veto_max_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "veto_triggered": {
          "type": "boolean"
        },
        "veto_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "yes_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "raw_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "final_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "label": {
          "enum": [
            "Excelente",
            "Saudavel",
            "Adequado",
            "Fragil",
            "Insuficiente"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "veto_triggered": {
                "const": true
              }
            },
            "required": [
              "veto_triggered"
            ]
          },
          "then": {
            "properties": {
              "veto_detail": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "veto_detail": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "clarityAssessment": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/dimensionAssessment"
        },
        {
          "properties": {
            "items": {
              "items": {
                "properties": {
                  "criterion_id": {
                    "pattern": "^CLA-(0[1-9]|10)$"
                  }
                }
              }
            },
            "veto_item_id": {
              "const": "CLA-10"
            },
            "veto_max_score": {
              "const": 2
            }
          }
        }
      ]
    },
    "evidenceAssessment": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/dimensionAssessment"
        },
        {
          "properties": {
            "items": {
              "items": {
                "properties": {
                  "criterion_id": {
                    "pattern": "^EVI-(0[1-9]|10)$"
                  }
                }
              }
            },
            "veto_item_id": {
              "const": "EVI-06"
            },
            "veto_max_score": {
              "const": 1
            }
          }
        }
      ]
    },
    "outcomesAssessment": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/dimensionAssessment"
        },
        {
          "properties": {
            "items": {
              "items": {
                "properties": {
                  "criterion_id": {
                    "pattern": "^OUT-(0[1-9]|10)$"
                  }
                }
              }
            },
            "veto_item_id": {
              "const": "OUT-10"
            },
            "veto_max_score": {
              "const": 2
            }
          }
        }
      ]
    },
    "actionabilityAssessment": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/dimensionAssessment"
        },
        {
          "properties": {
            "items": {
              "items": {
                "properties": {
                  "criterion_id": {
                    "pattern": "^ACT-(0[1-9]|10)$"
                  }
                }
              }
            },
            "veto_item_id": {
              "const": "ACT-10"
            },
            "veto_max_score": {
              "const": 2
            }
          }
        }
      ]
    },
    "scoresBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "dimensions",
            "anti_clustering"
          ],
          "properties": {
            "section_key": {
              "const": "scores"
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clarity",
                "evidence",
                "outcomes",
                "actionability"
              ],
              "properties": {
                "clarity": {
                  "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/clarityAssessment"
                },
                "evidence": {
                  "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/evidenceAssessment"
                },
                "outcomes": {
                  "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/outcomesAssessment"
                },
                "actionability": {
                  "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/actionabilityAssessment"
                }
              }
            },
            "anti_clustering": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triggered",
                "original_scores",
                "span",
                "re_evaluation_notes"
              ],
              "properties": {
                "triggered": {
                  "type": "boolean"
                },
                "original_scores": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "span": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "re_evaluation_notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "triggered": {
                        "const": true
                      }
                    },
                    "required": [
                      "triggered"
                    ]
                  },
                  "then": {
                    "properties": {
                      "original_scores": {
                        "type": "array"
                      },
                      "re_evaluation_notes": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "original_scores": {
                        "type": "null"
                      },
                      "re_evaluation_notes": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "iqbBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "metric"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "score",
            "classification",
            "diagnosis"
          ],
          "properties": {
            "section_key": {
              "const": "iqb"
            },
            "score": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "classification": {
              "enum": [
                "Excelente",
                "Saudavel",
                "Adequado",
                "Fragil",
                "Insuficiente"
              ]
            },
            "diagnosis": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stringListBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "strengthsBlock": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/stringListBlock"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "section_key": {
                  "const": "strengths"
                }
              }
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "title",
        "problem",
        "impact",
        "action",
        "tag"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "enum": [
            "critical",
            "warning",
            "info"
          ]
        }
      }
    },
    "gapsBlock": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "data": {
          "type": "object",
          "required": [
            "section_key",
            "rows"
          ],
          "properties": {
            "section_key": {
              "const": "gaps"
            },
            "rows": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/gap"
              }
            }
          }
        }
      }
    },
    "provocationsBlock": {
      "allOf": [
        {
          "$ref": "urn:eric:schemas:briefing-validation-report#/$defs/stringListBlock"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "section_key": {
                  "const": "provocations"
                },
                "items": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      ]
    }
  }
}
