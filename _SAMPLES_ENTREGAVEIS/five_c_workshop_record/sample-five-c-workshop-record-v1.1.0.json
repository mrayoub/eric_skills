      "type": "heading"
    },
    {
      "citation_ids": [
        "FIC-01"
      ],
      "data": {
        "section_key": "sessions",
        "text": "Uma sessão presencial fictícia de 5C oficial, de C1 a C5. Cinco presentes de três organizações fictícias, entre oito convidados. Três votos por pessoa em C2 e dez créditos por pessoa em C5."
      },
      "id": "sessions",
      "type": "paragraph"
    },
    {
