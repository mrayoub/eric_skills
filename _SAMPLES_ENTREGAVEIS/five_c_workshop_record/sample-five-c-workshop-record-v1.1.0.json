      "data": {
        "section_key": "starting_point",
        "text": "Objetivo fictício: entender as dores das solicitações de dados antes de propor soluções. Perguntas a responder: as dores de acompanhamento continuam atuais e onde estão as causas?"
      },
      "id": "starting_point",
      "type": "paragraph"
    },
    {
      "data": {
