    },
    {
      "citation_ids": [
        "FIC-01"
      ],
      "data": {
        "section_key": "c1",
        "text": "No encontro fictício, a equipe apresentou o desafio e registrou dúvidas sobre origem das devoluções."
      },
      "id": "c1",
      "type": "paragraph"
    },
    {
