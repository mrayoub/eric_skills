      "type": "paragraph",
      "data": {
        "section_key": "d1",
        "text": "Participantes fictícios relataram incerteza sobre o andamento das solicitações e divergiram sobre a principal causa."
      },
      "citation_ids": [
        "FIC-01"
      ]
    },
    {
      "id": "heading-d2",
